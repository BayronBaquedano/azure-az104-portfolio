@page
@model FitAppReservations.Pages.Trainers.IndexModel
@{
    ViewData["Title"] = "Trainers";
}

<section class="page-header d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-center">
    <div>
        <h1 class="mb-1">Trainers</h1>
        <p class="text-muted mb-0">Manage trainer profiles and active booking availability.</p>
    </div>
    <a class="btn btn-primary" asp-page="Create">Add trainer</a>
</section>

<section class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-8">
                <label asp-for="Search" class="form-label">Search</label>
                <input asp-for="Search" class="form-control" placeholder="Search by name or specialty" />
            </div>
            <div class="col-md-4">
                <div class="actions-group">
                    <button type="submit" class="btn btn-primary">Search</button>
                    <a class="btn btn-outline-secondary" asp-page="Index">Clear</a>
                </div>
            </div>
        </form>
    </div>
</section>

<section class="card shadow-sm">
    <div class="card-body">
        @if (Model.Trainers.Count == 0)
        {
            <div class="empty-state">
                <h2 class="h5">No trainers found</h2>
                <p class="text-muted mb-4">Create the first trainer profile to start accepting reservations.</p>
                <a class="btn btn-primary" asp-page="Create">Create trainer</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Full name</th>
                            <th>Specialty</th>
                            <th>Hourly rate</th>
                            <th>Status</th>
                            <th>Reservations</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var trainer in Model.Trainers)
                    {
                        <tr>
                            <td>@trainer.FullName</td>
                            <td>@trainer.Specialty</td>
                            <td>@trainer.HourlyRate.ToString("C")</td>
                            <td>
                                <span class="badge @(trainer.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                    @(trainer.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>@trainer.ReservationCount</td>
                            <td class="text-end">
                                <div class="actions-group justify-content-end">
                                    <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@trainer.Id">Edit</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@trainer.Id" class="d-inline">
                                        <input type="hidden" asp-for="Search" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Delete this trainer? This only works when there are no reservations linked to the trainer.');">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
