@page "{id:int}"
@model FitAppReservations.Pages.Clients.EditModel
@{
    ViewData["Title"] = "Edit Client";
}

<section class="page-header">
    <h1 class="mb-1">Edit client</h1>
    <p class="text-muted mb-0">Update client contact details and internal notes.</p>
</section>

<section class="form-panel">
    <form method="post" class="row g-4">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="col-md-6">
            <label asp-for="Input.FullName" class="form-label"></label>
            <input asp-for="Input.FullName" class="form-control" />
            <span asp-validation-for="Input.FullName" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Input.Phone" class="form-label"></label>
            <input asp-for="Input.Phone" class="form-control" />
            <span asp-validation-for="Input.Phone" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Input.Notes" class="form-label"></label>
            <textarea asp-for="Input.Notes" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Input.Notes" class="text-danger"></span>
        </div>

        <div class="col-12">
            <div class="actions-group">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a class="btn btn-outline-secondary" asp-page="Index">Cancel</a>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
